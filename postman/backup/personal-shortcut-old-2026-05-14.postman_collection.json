    {
      "name": "Jira Todos",
      "item": [
        {
          "name": "Create Issue",
          "id": "8db55c21-9135-40ed-9aeb-7cc6e4481fae",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Your issue title here\",\n  \"description\": \"Optional description\",\n  \"issuetype\": \"Task\",\n  \"duedate\": \"2026-05-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/todos/create/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "todos",
                "create",
                ""
              ]
            },
            "description": "Creates a new Jira issue in the TODO project.\n\n**Fields:**\n- `summary` (required) — issue title\n- `description` (optional) — plain text\n- `issuetype` (optional) — Task / Bug / Story (default: Task)\n- `duedate` (optional) — any date format e.g. \"2026-05-20\", \"20 May 2026\", \"14 May 2026 at 2:41 PM\"\n\n**Returns:** `{ \"key\": \"TODO-42\", \"url\": \"...\" }`"
          },
          "response": [],
          "createdAt": "2026-05-14T14:53:05.000Z",
          "updatedAt": "2026-05-14T14:53:05.000Z",
          "uid": "41183902-8db55c21-9135-40ed-9aeb-7cc6e4481fae"
        },
        {
          "name": "Create Issue — Bug",
          "id": "66968c95-12f2-4bd9-8342-203fbc65839f",
