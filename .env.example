NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_EXPENSES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_HABITS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SECRET_KEY=your-django-secret-key-here
DEBUG=False

# Multi-user expenses — one profile per person, selected by login email.
# List every active profile name here (comma-separated); the first is the
# default used by the open /api/ routes and the homepage stats widget,
# since those have no logged-in session to resolve a profile from. Each
# profile's own database needs the same Expense/Amount/Date/Category/
# Source/Mode property names and types as the primary one (see
# expenses/service.py's _build_page_properties for the exact shape).
EXPENSE_PROFILES=ABHINAV
ABHINAV_EMAIL=you@example.com
ABHINAV_NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABHINAV_NOTION_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANCHAL_EMAIL=
# ANCHAL_NOTION_TOKEN=
# ANCHAL_NOTION_DB=

# Postgres (expenses are being migrated off Notion into this). Any hosted
# Postgres works (Neon / Supabase / Render). Then run: python manage.py migrate
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to False for a local Postgres without SSL.
DATABASE_SSL_REQUIRE=True

# Jira
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_PROJECT_KEY=TODO

# Splitwise — register an app at https://secure.splitwise.com/apps to get these.
# The API key enables the no-redirect personal auth flow.
SPLITWISE_CONSUMER_KEY=your-splitwise-consumer-key
SPLITWISE_CONSUMER_SECRET=your-splitwise-consumer-secret
SPLITWISE_API_KEY=your-splitwise-api-key

# Users app (token auth at /api/users/). Set SIGNUP_ENABLED=False to close signup.
SIGNUP_ENABLED=True
AUTH_TOKEN_TTL_DAYS=30
# A bare 10-digit phone number is assumed to be in this country.
DEFAULT_PHONE_COUNTRY_CODE=+91
# Wrong passwords before an account locks, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
